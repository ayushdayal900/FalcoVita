      "boundElements": null,
      "updated": 1760895245084,
      "link": null,
      "locked": false,
      "text": "User <→ Doctor: (1-to-1) via UserID\n\nUser <→ Patient: (1-to-1) via UserID\n\nDoctor <→ Department: (Many-to-1)\n\nDoctor <→ Availability: (1-to-Many)\n\nPatient <→ Appointment: (1-to-Many)\n\nDoctor <→ Appointment: (1-to-Many)\n\nAppointment <→ Department: (Many-to-1)\n\nPatientHistory <→ Patient, Doctor, Department: (Many-to-1 each)\n\nPatientHistory <→ Prescription: (1-to-Many)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User <→ Doctor: (1-to-1) via UserID\n\nUser <→ Patient: (1-to-1) via UserID\n\nDoctor <→ Department: (Many-to-1)\n\nDoctor <→ Availability: (1-to-Many)\n\nPatient <→ Appointment: (1-to-Many)\n\nDoctor <→ Appointment: (1-to-Many)\n\nAppointment <→ Department: (Many-to-1)\n\nPatientHistory <→ Patient, Doctor, Department: (Many-to-1 each)\n\nPatientHistory <→ Prescription: (1-to-Many)",
      "autoResize": false,
      "lineHeight": 1.25
    },
